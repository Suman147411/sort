#include <iostream>
#include <vector>
#include <queue>
#include <climits>
using namespace std;

void dijkstra(int source, int n, vector<pair<int, int>> adj[]) {
    vector<int> dist(n, INT_MAX);

    // Min-heap: {distance, vertex}
    priority_queue<pair<int, int>,
                   vector<pair<int, int>>,
                   greater<pair<int, int>>> pq;

    dist[source] = 0;
    pq.push({0, source});

    while (!pq.empty()) {
        int d = pq.top().first;
        int u = pq.top().second;
        pq.pop();

        // Ignore outdated entry
        if (d != dist[u])
            continue;

        for (auto edge : adj[u]) {
            int v = edge.first;
            int weight = edge.second;

            if (dist[u] + weight < dist[v]) {
                dist[v] = dist[u] + weight;
                pq.push({dist[v], v});
            }
        }
    }

    cout << "Shortest distances from source " << source << ":\n";

    for (int i = 0; i < n; i++) {
        if (dist[i] == INT_MAX)
            cout << i << " -> INF\n";
        else
            cout << i << " -> " << dist[i] << "\n";
    }
}

int main() {
    int n = 5;

    vector<pair<int, int>> adj[n];

    // {destination, weight}
    adj[0].push_back({1, 10});
    adj[0].push_back({2, 3});

    adj[1].push_back({2, 1});
    adj[1].push_back({3, 2});

    adj[2].push_back({1, 4});
    adj[2].push_back({3, 8});
    adj[2].push_back({4, 2});

    adj[3].push_back({4, 7});

    adj[4].push_back({3, 9});

    dijkstra(0, n, adj);

    return 0;
}
